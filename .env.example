# Copy this file to .env and fill in the values you need. .env itself is
# gitignored - never commit it.

# Folder of an unzipped Vosk speech-recognition model (download one from
# https://alphacephei.com/vosk/models, e.g. vosk-model-small-en-us-0.15),
# used by the Voice Reference dock's "Vosk" auto-transcription engine
# (kokoro_gui/engine/asr.py). Leave unset if you use another engine
# (Whisper or Audio8-ASR-0.1B). You can also set/edit this from the dock itself
# (Browse/Save/Reload next to the Vosk model field) instead of by hand.
VOSK_MODEL_PATH=

# faster-whisper model for the default "Whisper" auto-transcription engine
# (kokoro_gui/engine/asr.py). Defaults to large-v3-turbo (about 1.6 GB, fetched
# from Hugging Face the first time it's used). On a slow machine pick a smaller
# one: small (484 MB), base (145 MB) or tiny (75 MB); a local model folder also works.
WHISPER_MODEL=
